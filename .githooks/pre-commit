#!/bin/bash
# Pre-commit checks. CI runs on Linux only (ADR 0011), so this hook is what
# covers the macOS workstation. Install it with:
#
#   git config core.hooksPath .githooks
#
# Bypass with `git commit --no-verify` when you need to.

set -euo pipefail

run() {
  printf 'pre-commit: %s\n' "$*" >&2
  "$@"
}

if command -v uv >/dev/null 2>&1 && [[ -f pyproject.toml ]]; then
  run uv run ruff check .
  run uv run ruff format --check src tests/unit scripts
  run uv run mypy
  run uv run pytest -q
else
  printf 'pre-commit: uv or pyproject.toml missing, skipping Python checks\n' >&2
fi

run python3 scripts/check_markdown.py
