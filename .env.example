# Shared secrets for all Ugoos provisioning and configuration scripts.
#
# Copy this file to .env, set KODI_WEB_PASSWORD, and keep the file private:
#   cp .env.example .env
#   chmod 600 .env
#
# This is sourced as shell syntax. Quote values, especially values containing
# spaces, #, $, quotes, or other shell metacharacters. Do not commit .env.

# Required when provision.conf has APPLY_KODI=1 and for live add-on operations.
KODI_WEB_PASSWORD=''

# Metadata provider credentials. Set both for a real Kodi baseline deployment.
OMDB_API_KEY=''
MDBLIST_API_KEY=''

# Optional Home Assistant endpoint and long-lived access token.
HOME_ASSISTANT_URL=''
HOME_ASSISTANT_TOKEN=''

# Optional NextPVR endpoint and PIN.
NEXTPVR_HOST=''
NEXTPVR_PIN=''

# Home Assistant's public key for the restricted Kodi lifecycle gateway. One
# OpenSSH public key line; the Reconciler writes it into the device's
# authorized_keys behind a forced command that can only start, stop or query
# kodi.service. A public key is not a secret, but it is per-deployment, and
# per-deployment values live here (ADR 0016).
COREELEC_LIFECYCLE_PUBLIC_KEY=''
