# Named Values: what the Profile names but no committed file may hold.
#
# Copy this file to .env, fill in every key, and keep the file private:
#   cp .env.example .env
#   chmod 600 .env
#
# The Reconciler reads this file as data with a strict KEY=value grammar; it is
# never sourced. Single-quote any value holding a space, a quote, or a shell
# metacharacter. Every key below is named by the Profile, and a Run is refused
# while any of them is missing or empty (ADR 0014). Do not commit .env.

# Kodi's JSON-RPC web server password.
KODI_WEB_PASSWORD=''

# Metadata provider credentials for TMDb Helper.
OMDB_API_KEY=''
MDBLIST_API_KEY=''

# Home Assistant endpoint and long-lived access token for the weather add-on.
HOME_ASSISTANT_URL=''
HOME_ASSISTANT_TOKEN=''

# NextPVR endpoint and PIN for the PVR client.
NEXTPVR_HOST=''
NEXTPVR_PIN=''

# Home Assistant's public key for the restricted Kodi lifecycle gateway. One
# OpenSSH public key line; the Reconciler writes it into the Device's
# authorized_keys behind a forced command that can only start, stop or query
# kodi.service. A public key is not a secret, but it is per-deployment, and
# per-deployment values live here (ADR 0016).
COREELEC_LIFECYCLE_PUBLIC_KEY=''
