# Shared secrets for all Ugoos provisioning and configuration scripts.
#
# Copy this file to .env, set KODI_WEB_PASSWORD, and keep the file private:
#   cp .env.example .env
#   chmod 600 .env
#
# This is sourced as shell syntax. Quote values, especially values containing
# spaces, #, $, quotes, or other shell metacharacters. Do not commit .env.

# Required when provision.conf has APPLY_KODI=1 and for live add-on operations.
KODI_WEB_PASSWORD=''

# Metadata provider credentials. Set both for a real Kodi baseline deployment.
OMDB_API_KEY=''
MDBLIST_API_KEY=''

# Optional YouTube credentials. Set all three together or leave all three empty.
YOUTUBE_API_KEY=''
YOUTUBE_CLIENT_ID=''
YOUTUBE_CLIENT_SECRET=''

# Optional Home Assistant long-lived access token. Requires
# HOME_ASSISTANT_URL in provision.conf.
HOME_ASSISTANT_TOKEN=''

# Optional NextPVR PIN. Requires NEXTPVR_HOST in provision.conf.
NEXTPVR_PIN=''

# Optional Plex token. Requires PLEX_SERVER_HOST in provision.conf.
PLEX_TOKEN=''

# Optional Emby password for guided sign-in. Requires EMBY_SERVER_URL and
# EMBY_USERNAME in provision.conf.
EMBY_PASSWORD=''
