# One Host block per Device. The alias is the Kodi Lifecycle blueprint's
# SSH host input; copy the block and change Host and HostName for another
# Device.

Host ugoos-theater-lifecycle
  HostName ugoos-theater.lan.wavebe.am
  User root
  Port 22
  IdentityFile /config/.ssh/ugoos_kodi_lifecycle_ed25519
  UserKnownHostsFile /config/.ssh/known_hosts
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking yes
  ConnectTimeout 12
  ConnectionAttempts 1
  RequestTTY no
  ClearAllForwardings yes
